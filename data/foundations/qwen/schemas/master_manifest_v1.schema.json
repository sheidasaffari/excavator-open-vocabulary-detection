{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sheidasaffari/excavator-open-vocabulary-detection/blob/main/data/foundations/qwen/schemas/master_manifest_v1.schema.json",
  "title": "Excavision master manifest row",
  "type": "object",
  "required": [
    "sample_id",
    "schema_version",
    "manifest_release",
    "source_collection",
    "source_stem",
    "paths",
    "modalities",
    "instance_count",
    "validation_status"
  ],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "excavision-master-manifest/1.0.0"},
    "manifest_release": {"type": "string", "minLength": 1},
    "source_collection": {
      "enum": ["excavision_processed", "newgen_r1", "newgen_r2", "newgen_r3", "colored", "colored_green"]
    },
    "source_stem": {"type": "string", "minLength": 1},
    "source_root_alias": {"type": "string"},
    "generation_group_id": {"type": ["string", "null"]},
    "scene_id": {"type": ["string", "null"]},
    "camera_id": {"type": ["string", "integer", "null"]},
    "frame_id": {"type": ["string", "integer", "null"]},
    "paths": {
      "type": "object",
      "required": ["image", "label_2d", "label_3d", "occlusion"],
      "properties": {
        "image": {"type": "string"},
        "label_2d": {"type": "string"},
        "label_3d": {"type": "string"},
        "occlusion": {"type": "string"},
        "depth": {"type": ["string", "null"]},
        "depth_metadata": {"type": ["string", "null"]},
        "canonical_annotation": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "modalities": {
      "type": "object",
      "required": ["rgb", "labels_2d", "labels_3d", "occlusion", "dense_depth"],
      "properties": {
        "rgb": {"type": "boolean"},
        "labels_2d": {"type": "boolean"},
        "labels_3d": {"type": "boolean"},
        "occlusion": {"type": "boolean"},
        "camera": {"type": "boolean"},
        "dense_depth": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "instance_count": {"type": "integer", "minimum": 0},
    "view_type": {"enum": ["aerial", "ground", "mixed", "unknown"]},
    "difficulty": {"type": ["string", "number", "null"]},
    "selection_features": {"type": "object"},
    "split_group_id": {"type": ["string", "null"]},
    "split": {"enum": ["train", "validation", "test", "unassigned"]},
    "checksums": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
    },
    "validation_status": {"enum": ["valid", "warning", "invalid"]},
    "validation_flags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
